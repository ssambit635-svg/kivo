<?xml version="1.0" encoding="utf-8"?>
<!--
  Single-activity shell:
    native bar (title + server + overflow menu)
    thin progress bar
    FrameLayout holding the WebView, the first-run server screen and the
    "could not reach the server" screen (only one of the three is visible).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_background"
    android:fitsSystemWindows="false"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/native_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/native_bar_height"
        android:fitsSystemWindows="true"
        android:background="@color/brand"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/pad"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/bar_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/on_brand"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bar_server"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:maxWidth="150dp"
            android:textColor="@color/on_brand_dim"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/btn_menu"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/menu"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_overflow" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progressDrawable="@drawable/progress_bar"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- first run: pick the server -->
        <ScrollView
            android:id="@+id/setup_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/window_background"
            android:fillViewport="true"
            android:fitsSystemWindows="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/pad_lg"
                android:paddingTop="40dp"
                android:paddingEnd="@dimen/pad_lg"
                android:paddingBottom="@dimen/pad_lg">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="@string/app_name"
                    android:src="@mipmap/ic_launcher" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pad"
                    android:text="@string/app_name"
                    android:textColor="@color/ink"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/setup_subtitle"
                    android:textColor="@color/ink_dim"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/setup_label"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/setup_server_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/field_background"
                    android:hint="@string/setup_placeholder"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:minHeight="52dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_faint"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btn_connect"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="@dimen/pad"
                    android:backgroundTint="@color/brand"
                    android:text="@string/setup_connect"
                    android:textAllCaps="false"
                    android:textColor="@color/on_brand"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/setup_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/setup_hint"
                    android:textColor="@color/ink_dim"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </ScrollView>

        <!-- the server could not be reached -->
        <ScrollView
            android:id="@+id/error_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/window_background"
            android:fillViewport="true"
            android:fitsSystemWindows="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/pad_lg"
                android:paddingTop="56dp"
                android:paddingEnd="@dimen/pad_lg"
                android:paddingBottom="@dimen/pad_lg">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="@string/error_title"
                    android:src="@drawable/ic_cloud_off"
                    android:tint="@color/ink_faint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pad"
                    android:text="@string/error_title"
                    android:textColor="@color/ink"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/error_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/ink_dim"
                    android:textSize="13.5sp" />

                <Button
                    android:id="@+id/btn_retry"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="26dp"
                    android:backgroundTint="@color/brand"
                    android:text="@string/error_retry"
                    android:textAllCaps="false"
                    android:textColor="@color/on_brand"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_change_server"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/surface"
                    android:text="@string/error_change_server"
                    android:textAllCaps="false"
                    android:textColor="@color/brand"
                    android:textSize="14sp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

</LinearLayout>
