{
  "name": "medtwin-ai-backend",
  "version": "0.1.0",
  "private": true,
  "description": "MedTwin AI - AI-Powered Digital Health Twin backend (cost-free MVP, hackathon prototype)",
  "type": "module",
  "engines": {
    "node": ">=20.13.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning src/server.js",
    "kill-port": "node scripts/free-port.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.js",
    "security:scan": "node scripts/security-scan.js",
    "security:headers": "node --disable-warning=ExperimentalWarning scripts/security-headers.js",
    "security:deps": "node scripts/security-audit.js",
    "security:all": "npm run security:scan && npm run security:headers && npm run security:deps",
    "seed:admin": "node scripts/create-admin.js",
    "seed:demo": "node scripts/seed-demo.js",
    "apk:build": "node scripts/apk/build-apk.js",
    "ocr:setup": "node scripts/ocr-setup.js",
    "knowledge:vendor": "node scripts/knowledge/vendor.js",
    "knowledge:build": "node scripts/knowledge/build.js",
    "knowledge:train": "node scripts/knowledge/train.js",
    "knowledge:verify": "node scripts/knowledge/verify.js",
    "knowledge:all": "npm run knowledge:build && npm run knowledge:train",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "tesseract.js": "^7.0.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "supertest": "^7.1.0",
    "vitest": "^2.1.9"
  }
}
