# MedTwin AI backend configuration
NODE_ENV=development
HOST=0.0.0.0
PORT=8080

# REQUIRED in production. Any long random string — the app refuses to boot in prod without it.
JWT_SECRET=change-me-to-a-long-random-string

# sessions
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800
LOGIN_MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15

# storage (cost-free local)
DB_PATH=data/medtwin.db
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# comma-separated allowlist for cross-origin frontends; same-origin dashboard/API
# requests are accepted automatically. In dev, localhost + *.e2b.app previews +
# capacitor/ionic app shells + private-LAN origins (phone demo over wifi) are auto-allowed.
CORS_ORIGINS=

# rate limiting
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_AUTH_MAX=30

# automated abuse detection (SecurityMonitor): cross-endpoint 401/403
# failures per IP; offenders are auto-blocked + audit-alerted
SECURITY_MONITOR_ENABLED=true
SECURITY_MONITOR_MAX_FAILURES=60
SECURITY_MONITOR_WINDOW_MS=300000
SECURITY_MONITOR_BLOCK_MS=900000

# AI providers — cost-free defaults; 'grounded-local' narrates from validated structured data only
LLM_PROVIDER=grounded-local
OCR_PROVIDER=auto
